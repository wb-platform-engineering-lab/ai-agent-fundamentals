+import sqlite3
+import logging
+
+DB_PASSWORD = "prod_password_123"  # TODO: move to env
+
+def get_user(user_id):
+    conn = sqlite3.connect("users.db")
+    cursor = conn.cursor()
+    query = f"SELECT * FROM users WHERE id = {user_id}"
+    cursor.execute(query)
+    user = cursor.fetchone()
+    conn.close()
+    return user
+
+def get_user_orders(user_id):
+    orders = []
+    conn = sqlite3.connect("orders.db")
+    cursor = conn.cursor()
+    cursor.execute("SELECT id FROM orders WHERE user_id = ?", (user_id,))
+    order_ids = cursor.fetchall()
+    for order_id in order_ids:
+        cursor.execute("SELECT * FROM order_items WHERE order_id = ?", (order_id[0],))
+        items = cursor.fetchall()
+        orders.append({"id": order_id[0], "items": items})
+    conn.close()
+    return orders
+
+def update_user_email(user_id, new_email):
+    logging.info(f"Updating email for user {user_id} to {new_email}")
+    conn = sqlite3.connect("users.db")
+    cursor = conn.cursor()
+    cursor.execute(
+        f"UPDATE users SET email = '{new_email}' WHERE id = {user_id}"
+    )
+    conn.commit()
+    conn.close()
+    return True
+
+def search_users(query_string):
+    conn = sqlite3.connect("users.db")
+    cursor = conn.cursor()
+    results = cursor.execute(
+        f"SELECT * FROM users WHERE name LIKE '%{query_string}%' OR email LIKE '%{query_string}%'"
+    ).fetchall()
+    conn.close()
+    return results
